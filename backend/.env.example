# Порт API (по умолчанию 5100: 5000 занят taxi-backend)
PORT=5100

# PostgreSQL (pg Pool, сырой SQL; порт хоста из docker-compose.yml)
DATABASE_URL=postgres://erp:erp@localhost:5434/erp

# Общий лимит запросов с одного IP в минуту
RATE_LIMIT=300

# Секрет для JWT — обязателен, без него сервер не стартует.
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=

# Срок жизни JWT в днях
JWT_TTL_DAYS=30

# Пароль сида-админа (логин — admin). По умолчанию admin123 — только для разработки
ADMIN_PASSWORD=admin123
