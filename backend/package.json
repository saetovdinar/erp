{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Мониторинг такси: API (Express 5 + PostgreSQL, паттерн taxi/backend)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "ts-node-dev --transpile-only src/db/setup.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "pg": "8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
